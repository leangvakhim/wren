{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main view only (not the browser panel): core APIs, the native folder picker, in-app updates, system notifications, and Wren's own commands (including the phone link).",
  "webviews": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "dialog:allow-open",
    "updater:default",
    "process:allow-restart",
    "notification:default",
    "allow-open-pane",
    "allow-update-pane",
    "allow-send-message",
    "allow-attach-bytes",
    "allow-attach-file",
    "allow-attachment-preview",
    "allow-set-model",
    "allow-set-mode",
    "allow-set-github",
    "allow-set-ai-browser",
    "allow-set-folder",
    "allow-browser-open",
    "allow-browser-place",
    "allow-browser-go",
    "allow-browser-close",
    "allow-open-external",
    "allow-visual-url",
    "allow-recent-visuals",
    "allow-answer-approval",
    "allow-answer-question",
    "allow-carry-session",
    "allow-set-permission",
    "allow-save-report",
    "allow-plan-limits",
    "allow-resume-conversation",
    "allow-list-models",
    "allow-list-conversations",
    "allow-get-conversation",
    "allow-save-conversation",
    "allow-delete-conversation",
    "allow-rename-conversation",
    "allow-usage-records",
    "allow-new-conversation",
    "allow-stop-pane",
    "allow-close-pane",
    "allow-detect-clis",
    "allow-default-folder",
    "allow-folder-kind",
    "allow-data-folder",
    "allow-list-accounts",
    "allow-add-account",
    "allow-rename-account",
    "allow-remove-account",
    "allow-check-account",
    "allow-set-active-antigravity",
    "allow-start-login",
    "allow-login-input",
    "allow-login-resize",
    "allow-cancel-login",
    "allow-github-cli",
    "allow-list-github",
    "allow-add-github",
    "allow-rename-github",
    "allow-check-github",
    "allow-remove-github",
    "allow-start-github-login",
    "allow-reset-wren",
    "allow-remote-attach",
    "allow-remote-configure",
    "allow-remote-pair",
    "allow-remote-cancel-pair",
    "allow-remote-confirm",
    "allow-remote-remove-device",
    "allow-remote-rename-device",
    "allow-remote-send",
    "allow-remote-push"
  ]
